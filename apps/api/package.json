{
  "name": "@raise/api",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "node dist/db/migrate.js",
    "db:seed": "tsx src/db/seed.ts",
    "ratings:verify": "tsx src/scripts/verify-ratings.ts",
    "db:seed:demo": "tsx src/scripts/demo-seed.ts",
    "demo:me": "tsx src/scripts/demo-me.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.11",
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/swagger": "^11.2.2",
    "@nestjs/websockets": "^11.2.10",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@raise/game-configs": "workspace:*",
    "@raise/schemas": "workspace:*",
    "@raise/types": "workspace:*",
    "@sentry/node": "^9.47.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^6.7.6",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.9.2",
    "nestjs-pino": "^4.4.1",
    "obscenity": "^0.4.6",
    "pg": "^8.19.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@types/pg": "^8.15.7",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.8",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

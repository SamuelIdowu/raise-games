{
  "name": "@raise/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^8.1.1",
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.10",
    "@nestjs/swagger": "^11.2.2",
    "@raise/game-configs": "workspace:*",
    "@raise/schemas": "workspace:*",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.9.2",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.19.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@types/pg": "^8.15.7",
    "drizzle-kit": "^0.31.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}

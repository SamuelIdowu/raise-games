# ---- Core ----
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# ---- Database (Postgres) ----
DATABASE_URL=postgres://raise:raise@localhost:5432/raise

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-32-bytes-minimum-secret-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_MOCK_ENABLED=true
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
# Staging only: comma-separated E.164 numbers allowed to receive real SMS (empty in prod).
SMS_ALLOWLIST=

# ---- Email ----
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM="RAISE <hello@yourdomain.com>"

# ---- File storage (R2, S3-compatible) ----
# Local dev uses the docker compose "storage" service (SeaweedFS, S3-compatible):
#   STORAGE_ENDPOINT=http://localhost:9000  STORAGE_FORCE_PATH_STYLE=true  STORAGE_AUTO_CREATE_BUCKET=true
#   R2_ACCESS_KEY_ID=raise  R2_SECRET_ACCESS_KEY=raise-storage-secret
# Production leaves STORAGE_ENDPOINT empty and sets R2_ACCOUNT_ID. The bucket must be private.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false
STORAGE_AUTO_CREATE_BUCKET=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raise-proof-screenshots

# ---- Cloudflare Turnstile ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Origin of the screenshot bucket (presigned PUTs + signed reads); used by the web CSP.
# Prod: https://<account>.r2.cloudflarestorage.com
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000

# ---- Observability ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ---- Notifications (Sprint 11). All optional.
# Web push: generate once with `npx web-push generate-vapid-keys`; without keys, push is skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@raise.gg
# Email: Resend when set; otherwise a logging mock (vendor is an open owner decision: Resend vs SES).
RESEND_API_KEY=
EMAIL_FROM=RAISE <no-reply@raise.gg>
# Absolute web origin used in push/email deep links.
APP_URL=http://localhost:3000

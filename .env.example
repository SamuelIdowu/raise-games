# ---- Core ----
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Proxies in front of the API: 0 local, 1 host load balancer, 2 Cloudflare + load balancer.
# Per-IP rate limits read the client IP through this many hops. Never set it higher than real.
TRUST_PROXY=0
# Staging and production refuse to boot without real SMS, Turnstile and R2 settings (audit B4).
# Rollout stage for feature flags: 1 until Stage 2 launches.
APP_STAGE=1
# New WebSocket handshakes allowed per IP per minute (raise only for load tests on staging).
WS_CONNECT_LIMIT_PER_MIN=60

# ---- Database (Postgres) ----
# postgres:// or postgresql://. Managed hosts usually need ?sslmode=require.
DATABASE_URL=postgres://raise:raise@localhost:5432/raise

# ---- Redis ----
# redis:// locally; rediss:// (TLS) for managed Redis reached over the internet.
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-32-bytes-minimum-secret-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_MOCK_ENABLED=true
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
# Staging only: comma-separated E.164 numbers allowed to receive real SMS (empty in prod).
SMS_ALLOWLIST=

# ---- File storage (R2, S3-compatible) ----
# Local dev uses the docker compose "storage" service (SeaweedFS, S3-compatible):
#   STORAGE_ENDPOINT=http://localhost:9000  STORAGE_FORCE_PATH_STYLE=true  STORAGE_AUTO_CREATE_BUCKET=true
#   R2_ACCESS_KEY_ID=raise  R2_SECRET_ACCESS_KEY=raise-storage-secret
# Production leaves STORAGE_ENDPOINT empty and sets R2_ACCOUNT_ID. The bucket must be private.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false
STORAGE_AUTO_CREATE_BUCKET=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raise-proof-screenshots

# ---- Cloudflare Turnstile ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Origin of the screenshot bucket (presigned PUTs + signed reads); used by the web CSP.
# Prod: https://<account>.r2.cloudflarestorage.com
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000
# Public site origin for canonical URLs, Open Graph, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_* values are compiled in at build time. The web Docker image refuses to build
# unless API_URL, STORAGE_ORIGIN and SITE_URL are public https (WEB_BUILD_STRICT=false skips
# the check for a local-only image).
# Product analytics in the browser (optional; no key = no tracking).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Shown in error reports and beta feedback; CI sets them per build.
NEXT_PUBLIC_RELEASE_SHA=
NEXT_PUBLIC_APP_VERSION=

# ---- Observability ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
# Git SHA of the running API, tagged on error reports.
RELEASE_SHA=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# OpenTelemetry traces: set the OTLP endpoint to turn tracing on.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=raise-api
# Ops alerts (SLO burn, queue backlog) are also POSTed here as JSON when set.
ALERT_WEBHOOK_URL=

# ---- Notifications (Sprint 11). All optional.
# Web push: generate once with `npx web-push generate-vapid-keys`; without keys, push is skipped.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@raise.gg
# Email: Resend when set; otherwise a logging mock (vendor is an open owner decision: Resend vs SES).
RESEND_API_KEY=
EMAIL_FROM=RAISE <no-reply@raise.gg>
# Absolute web origin used in push/email deep links.
APP_URL=http://localhost:3000

# ---- Staff MFA (Sprint 12) ----
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Required outside development/test:
# it encrypts moderators' TOTP secrets at rest. Rotating it means staff re-enrol MFA.
MFA_ENCRYPTION_KEY=

# ---- Data retention (audit B28; owner and legal decision) ----
# Days to keep proof screenshots and match chat. Empty = keep forever (no purge runs).
SCREENSHOT_RETENTION_DAYS=
CHAT_RETENTION_DAYS=

# ---- Background jobs (ops and tests) ----
# Set any of these to true to stop that worker in this process, e.g. to run one dedicated
# worker instance or to keep integration tests quiet. Leave unset in normal deploys.
# OUTBOX_RELAY_DISABLED=true
# NOTIFICATIONS_JOBS_DISABLED=true
# CHAT_JOBS_DISABLED=true
# LEDGER_JOBS_DISABLED=true
# OPS_JOBS_DISABLED=true
# RETENTION_JOBS_DISABLED=true

# ---- Development only ----
# HMAC secret for the mock wallet provider's webhook route. Refused in production.
# MOCK_PROVIDER_WEBHOOK_SECRET=

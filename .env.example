# ---- Core ----
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# ---- Database (Postgres) ----
DATABASE_URL=postgres://raise:raise@localhost:5432/raise

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-32-bytes-minimum-secret-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_MOCK_ENABLED=true
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Email ----
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM="RAISE <hello@yourdomain.com>"

# ---- File storage (R2, S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=raise-proof-screenshots
R2_PUBLIC_BASE_URL=

# ---- Cloudflare Turnstile ----
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Observability ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
